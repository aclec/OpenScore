{
    "expo": {
        "name": "OpenScores",
        "slug": "openscores",
        "version": "1.0.0",
        "orientation": "portrait",
        "scheme": "openscores",
        "userInterfaceStyle": "automatic",
        "icon": "./assets/icon.png",
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.openscores.app",
            "infoPlist": {
                "ITSAppUsesNonExemptEncryption": false
            }
        },
        "android": {
            "package": "com.openscores.app",
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#FFFFFF"
            }
        },
        "plugins": [
            "expo-router",
            "expo-status-bar",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/splash-icon.png",
                    "imageWidth": 220,
                    "resizeMode": "contain",
                    "backgroundColor": "#FFFFFF"
                }
            ],
            "expo-sqlite",
            "react-native-edge-to-edge"
        ],
        "experiments": {
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "49f1aa51-50cd-4ac1-b058-608cadac1c76"
            }
        }
    }
}
